#!/usr/bin/env python3
r"""Edit the text of a PDF in your editor, in readable Unicode.

    pdf-text-edit in.pdf [-o out.pdf] [-f]
    pdf-text-edit in.pdf --fonts        # per-font mapping report, prints no page text

qpdf exports the PDF as JSON with streams decoded. Each page's content stream
(and the form XObjects it draws) is written to one UTF-8 file, with every
string a text-showing operator draws (Tj ' " TJ) replaced by «decoded text».
Decoding uses the active font's /ToUnicode CMap (bfchar and bfrange), falling
back to the base encoding for simple fonts. After the editor exits, the edited
text is re-encoded through the same maps, the changed streams go back through
qpdf --update-from-json, and qpdf recompresses and checks the result.

Inside «»: \\ is a backslash, \» a closing mark, and \<hex> a glyph code with no
Unicode mapping. A character you type must already exist in that font's map,
because embedded fonts are usually subsets holding only the glyphs the document
used; the script lists any it can't encode and offers to reopen the editor.

The input file is never modified. The output defaults to <in>.edited.pdf.
The decoded text lives in a private .pdf-text-edit-* directory in the current
directory, deleted on exit unless a failure leaves edits you still need.
"""

import argparse
import base64
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

TEXT_OPS = {"Tj", "'", '"', "TJ"}
MARK_OPEN, MARK_CLOSE = "«", "»"
STREAM_HEADER = "%%%% stream "


def die(msg):
    sys.exit(f"pdf-text-edit: {msg}")


class KeepWorkspace(Exception):
    """A failure after which the workspace holds edits or files the user still needs."""


# --- qpdf ---------------------------------------------------------------

def qpdf_json(path):
    out = subprocess.run(
        ["qpdf", "--json=2", "--json-key=pages", "--json-key=qpdf",
         "--json-stream-data=inline", "--decode-level=generalized", path],
        capture_output=True, check=False)
    # qpdf exits 3 on warnings; the JSON is still complete.
    if out.returncode not in (0, 3):
        die(f"qpdf could not read {path}:\n{out.stderr.decode(errors='replace')}")
    return json.loads(out.stdout)


class Doc:
    def __init__(self, path):
        j = qpdf_json(path)
        self.header = j["qpdf"][0]
        self.objs = j["qpdf"][1]
        self.pages = j["pages"]

    def get(self, ref):
        """Resolve a reference ("5 0 R") to its value; other values pass through."""
        if isinstance(ref, str) and ref.endswith(" R"):
            o = self.objs.get("obj:" + ref)
            if o is None:
                return None
            return o["stream"]["dict"] if "stream" in o else o.get("value")
        return ref

    def stream(self, ref):
        o = self.objs["obj:" + ref]["stream"]
        if "data" not in o:
            die(f"stream {ref} could not be decoded by qpdf")
        return o["dict"], base64.b64decode(o["data"])

    def page_resources(self, page_ref):
        node = self.get(page_ref)
        while node is not None:
            if "/Resources" in node:
                return self.get(node["/Resources"]) or {}
            node = self.get(node.get("/Parent"))
        return {}


# --- fonts --------------------------------------------------------------

HEX = r"<([0-9A-Fa-f\s]*)>"


def hexbytes(s):
    s = re.sub(r"\s", "", s)
    if len(s) % 2:
        s += "0"
    return bytes.fromhex(s)


def utf16(b):
    return b.decode("utf-16-be", errors="replace")


def parse_cmap(text):
    """Return (code→unicode dict, [(length, lo, hi)] codespace ranges)."""
    cmap, space = {}, []
    for block in re.findall(r"begincodespacerange(.*?)endcodespacerange", text, re.S):
        for lo, hi in re.findall(HEX + r"\s*" + HEX, block):
            lo, hi = hexbytes(lo), hexbytes(hi)
            space.append((len(lo), lo, hi))
    for block in re.findall(r"beginbfchar(.*?)endbfchar", text, re.S):
        for src, dst in re.findall(HEX + r"\s*" + HEX, block):
            cmap[hexbytes(src)] = utf16(hexbytes(dst))
    for block in re.findall(r"beginbfrange(.*?)endbfrange", text, re.S):
        for lo, hi, dst in re.findall(HEX + r"\s*" + HEX + r"\s*(<[^>]*>|\[[^\]]*\])", block):
            lo, hi = hexbytes(lo), hexbytes(hi)
            n, a, b = len(lo), int.from_bytes(lo, "big"), int.from_bytes(hi, "big")
            if dst.startswith("["):
                for i, d in enumerate(re.findall(HEX, dst)):
                    if a + i <= b:
                        cmap[(a + i).to_bytes(n, "big")] = utf16(hexbytes(d))
            else:
                d = hexbytes(dst[1:-1])
                # Only the last byte of the destination increments across the range.
                for i in range(b - a + 1):
                    last = d[-1] + i
                    dd = d[:-1] + bytes([last & 0xFF]) if last <= 0xFF else d
                    cmap[(a + i).to_bytes(n, "big")] = utf16(dd)
    return cmap, space


BASE_CODECS = {"/WinAnsiEncoding": "cp1252", "/MacRomanEncoding": "mac_roman"}


class Font:
    def __init__(self, doc, ref, name):
        d = doc.get(ref) or {}
        self.name = name
        self.basefont = d.get("/BaseFont", "?")
        self.subtype = d.get("/Subtype", "?")
        self.composite = self.subtype == "/Type0"
        self.map, space = {}, []
        self.has_tounicode = "/ToUnicode" in d and doc.get(d["/ToUnicode"]) is not None
        if self.has_tounicode:
            _, data = doc.stream(d["/ToUnicode"])
            self.map, space = parse_cmap(data.decode("latin1"))
        if not self.composite:
            # A simple font's codes are one byte, whatever codespace its CMap declares.
            self.map = {bytes([v]): u for v, u in
                        ((int.from_bytes(k, "big"), u) for k, u in self.map.items()) if v < 256}
            space = [(1, b"\x00", b"\xff")]
            enc = doc.get(d.get("/Encoding"))
            base, overridden = None, set()
            if isinstance(enc, str):
                base = enc
            elif isinstance(enc, dict):
                base = enc.get("/BaseEncoding")
                code = 0
                for item in enc.get("/Differences", []):
                    if isinstance(item, (int, float)):
                        code = int(item)
                    else:
                        overridden.add(code)
                        code += 1
            codec = BASE_CODECS.get(base, "latin1")
            # An embedded subset has glyphs only for codes with a nonzero width;
            # a font without /Widths (one of the standard 14) has them all.
            widths = doc.get(d.get("/Widths"))
            first = int(d.get("/FirstChar", 0))
            has_glyph = (lambda c: True) if not widths else (
                lambda c: first <= c < first + len(widths) and (doc.get(widths[c - first]) or 0) > 0)
            for c in range(32, 256):
                k = bytes([c])
                if k in self.map or c in overridden or not has_glyph(c):
                    continue
                if codec == "latin1" and c > 126:
                    continue
                try:
                    self.map[k] = k.decode(codec)
                except UnicodeDecodeError:
                    pass
        self.space = space or [(2, b"\x00\x00", b"\xff\xff")]
        self.lengths = sorted({n for n, _, _ in self.space})
        self.reverse = {}
        for code, u in sorted(self.map.items(), reverse=True):
            self.reverse[u] = code  # lowest code wins on duplicates
        self.max_u = max((len(u) for u in self.reverse), default=1)

    def codes(self, raw):
        i = 0
        while i < len(raw):
            for n in self.lengths:
                c = raw[i:i + n]
                if len(c) == n and any(m == n and lo <= c <= hi for m, lo, hi in self.space):
                    break
            else:
                c = raw[i:i + self.lengths[0]]
            yield c
            i += len(c)

    def decode(self, raw):
        out = []
        for c in self.codes(raw):
            u = self.map.get(c)
            if u is None:
                out.append("\\<" + c.hex().upper() + ">")
            elif u == "\\":
                out.append("\\\\")
            elif u == MARK_CLOSE:
                out.append("\\" + MARK_CLOSE)
            else:
                out.append(u)
        return "".join(out)

    def encode(self, text, errors):
        out, i = bytearray(), 0
        while i < len(text):
            if text.startswith("\\<", i):
                j = text.index(">", i)
                out += hexbytes(text[i + 2:j])
                i = j + 1
                continue
            if text[i] == "\\" and i + 1 < len(text):
                i += 1  # escaped \ or »: encode the next character literally
                ch = text[i]
                code = self.reverse.get(ch)
                if code is None:
                    errors.add(ch)
                else:
                    out += code
                i += 1
                continue
            for n in range(min(self.max_u, len(text) - i), 0, -1):
                code = self.reverse.get(text[i:i + n])
                if code is not None:
                    out += code
                    i += n
                    break
            else:
                errors.add(text[i])
                i += 1
        return bytes(out)


# --- content stream tokens -----------------------------------------------
# A stream is handled as a latin1 str so every byte survives the round trip.

WS = "\x00\t\n\x0c\r "
DELIM = "()<>[]{}/%"
NUMBER = re.compile(r"[+-]?(\d+\.?\d*|\.\d+)")


def tokenize(s, edited=False):
    """Yield (kind, start, end). Kinds: ws, comment, str, hex, utext, open, close,
    dict, name, word, inline (an inline image's binary data)."""
    i, n = 0, len(s)
    while i < n:
        c = s[i]
        if c in WS:
            j = i
            while j < n and s[j] in WS:
                j += 1
            yield "ws", i, j
        elif c == "%":
            j = i
            while j < n and s[j] not in "\r\n":
                j += 1
            yield "comment", i, j
        elif edited and c == MARK_OPEN:
            j = i + 1
            while j < n and s[j] != MARK_CLOSE:
                j += 2 if s[j] == "\\" else 1
            if j >= n:
                raise ValueError(f"unclosed {MARK_OPEN} at character {i}")
            j += 1
            yield "utext", i, j
        elif c == "(":
            depth, j = 1, i + 1
            while j < n and depth:
                if s[j] == "\\":
                    j += 1
                elif s[j] == "(":
                    depth += 1
                elif s[j] == ")":
                    depth -= 1
                j += 1
            yield "str", i, j
        elif s.startswith("<<", i) or s.startswith(">>", i):
            yield "dict", i, i + 2
            j = i + 2
        elif c == "<":
            j = s.index(">", i) + 1
            yield "hex", i, j
        elif c in "[]{}":
            j = i + 1
            yield ("open" if c in "[{" else "close"), i, j
        else:
            j = i + 1 if c in DELIM else i
            while j < n and s[j] not in WS and s[j] not in DELIM:
                j += 1
            if j == i:
                j = i + 1
            word = s[i:j]
            kind = "name" if c == "/" else "num" if NUMBER.fullmatch(word) or word in ("true", "false", "null") else "word"
            yield kind, i, j
            if word == "ID":
                # Inline image data runs from one whitespace byte after ID to EI.
                m = re.compile(r"[\x00\t\n\x0c\r ]EI(?=[\x00\t\n\x0c\r ]|$)").search(s, j + 1)
                k = m.start() if m else n
                yield "inline", j, k
                j = k
        i = j


ESCAPES = {"n": "\n", "r": "\r", "t": "\t", "b": "\b", "f": "\f"}


def literal_bytes(tok):
    body, out, i = tok[1:-1], [], 0
    while i < len(body):
        c = body[i]
        if c == "\\" and i + 1 < len(body):
            e = body[i + 1]
            if e in ESCAPES:
                out.append(ESCAPES[e]); i += 2
            elif e in "01234567":
                m = re.match(r"[0-7]{1,3}", body[i + 1:])
                out.append(chr(int(m.group(), 8) & 0xFF)); i += 1 + len(m.group())
            elif e == "\r":
                i += 3 if body[i + 2:i + 3] == "\n" else 2
            elif e == "\n":
                i += 2
            else:
                out.append(e); i += 2
        elif c == "\r":
            out.append("\n"); i += 2 if body[i + 1:i + 2] == "\n" else 1
        else:
            out.append(c); i += 1
    return "".join(out).encode("latin1")


def string_bytes(kind, tok):
    return literal_bytes(tok) if kind == "str" else hexbytes(tok[1:-1])


def text_strings(s, edited=False):
    """Yield (start, end, kind, font name) for each string a text operator shows."""
    font, saved, operands, depth = None, [], [], 0
    for kind, a, b in tokenize(s, edited):
        if kind in ("ws", "comment", "inline"):
            continue
        if kind == "open":
            depth += 1
        elif kind == "close":
            depth -= 1
        if kind != "word" or depth:
            operands.append((kind, a, b))
            continue
        op = s[a:b]
        if op == "Tf":
            names = [s[x:y] for k, x, y in operands if k == "name"]
            font = names[-1] if names else font
        elif op == "q":
            saved.append(font)
        elif op == "Q" and saved:
            font = saved.pop()
        elif op in TEXT_OPS:
            strings = [(k, x, y) for k, x, y in operands if k in ("str", "hex", "utext")]
            if op != "TJ":
                strings = strings[-1:]
            for k, x, y in strings:
                yield x, y, k, font
        operands = []


# --- export and import ----------------------------------------------------

def collect_units(doc):
    """Return ([(stream ref, resources, label)], {stream ref: page numbers drawing it})
    for page contents and the forms they draw. A form shared by several pages is one
    stream, listed once; editing it changes every page that draws it."""
    units, pages_of, children = [], {}, {}

    def mark(ref, pageno):
        if pageno not in pages_of[ref]:
            pages_of[ref].add(pageno)
            for child in children[ref]:
                mark(child, pageno)

    def visit(ref, resources, label, pageno):
        if ref in pages_of:
            mark(ref, pageno)
            return
        pages_of[ref], children[ref] = {pageno}, []
        units.append((ref, resources, label))
        _, data = doc.stream(ref)
        xobjects = doc.get(resources.get("/XObject")) or {}
        for name in re.findall(r"(/[^\s/\[\]()<>{}%]+)\s+Do\b", data.decode("latin1")):
            xref = xobjects.get(name)
            xd = doc.get(xref)
            if isinstance(xref, str) and xd and xd.get("/Subtype") == "/Form":
                children[ref].append(xref)
                visit(xref, doc.get(xd.get("/Resources")) or resources,
                      f"{label}, form {name}", pageno)

    for page in doc.pages:
        n = page["pageposfrom1"]
        res = doc.page_resources(page["object"])
        for ref in page["contents"]:
            visit(ref, res, f"page {n}", n)
    return units, pages_of


class FontCache:
    def __init__(self, doc):
        self.doc, self.cache = doc, {}

    def get(self, resources, name):
        fonts = self.doc.get(resources.get("/Font")) or {}
        ref = fonts.get(name)
        if ref is None:
            return None
        if ref not in self.cache:
            self.cache[ref] = Font(self.doc, ref, name)
        return self.cache[ref]


def export(doc, units, fonts):
    parts = [
        f"% pdf-text-edit: edit the text between {MARK_OPEN} and {MARK_CLOSE}.\n"
        f"% Inside the marks, \\\\ is a backslash, \\{MARK_CLOSE} a closing mark, and \\<hex> a glyph\n"
        f"% code with no Unicode mapping. Leave the {STREAM_HEADER.strip()} lines in place.\n"]
    originals = {}
    for ref, res, label in units:
        _, data = doc.stream(ref)
        s = data.decode("latin1")
        originals[ref] = s
        out, last = [], 0
        for a, b, kind, fname in text_strings(s):
            font = fonts.get(res, fname)
            if font is None:
                continue  # unknown font: leave the raw string in place
            out.append(s[last:a])
            out.append(MARK_OPEN + font.decode(string_bytes(kind, s[a:b])) + MARK_CLOSE)
            last = b
        out.append(s[last:])
        parts.append(f"{STREAM_HEADER}{ref} ({label})\n" + "".join(out) + "\n")
    return "".join(parts), originals


def reimport(text, doc, units, fonts, originals):
    """Return ({ref: new data}, [error lines])."""
    sections = re.split(r"^" + re.escape(STREAM_HEADER) + r"(\d+ \d+ R)[^\n]*\n", text, flags=re.M)
    edited = dict(zip(sections[1::2], sections[2::2]))
    by_ref = {ref: res for ref, res, _ in units}
    changed, problems = {}, []
    if set(edited) != set(by_ref):
        problems.append("stream header lines were added, removed or changed; "
                        f"expected {sorted(by_ref)}, found {sorted(edited)}")
        return changed, problems
    for ref, body in edited.items():
        body = body[:-1] if body.endswith("\n") else body
        res = by_ref[ref]
        try:
            spans = list(text_strings(body, edited=True))
        except ValueError as e:
            problems.append(f"stream {ref}: {e}")
            continue
        orig = originals[ref]
        orig_spans = {}
        for a, b, kind, fname in text_strings(orig):
            font = fonts.get(res, fname)
            if font:
                orig_spans.setdefault((fname, font.decode(string_bytes(kind, orig[a:b]))), orig[a:b])
        out, last = [], 0
        for a, b, kind, fname in spans:
            if kind != "utext":
                continue
            font = fonts.get(res, fname)
            if font is None:
                problems.append(f"stream {ref}: text at character {a} has no known font")
                continue
            inner = body[a + 1:b - 1]
            out.append(body[last:a])
            keep = orig_spans.get((fname, inner))
            if keep is not None:
                out.append(keep)  # unchanged text keeps its original bytes
            else:
                errs = set()
                raw = font.encode(inner, errs)
                if errs:
                    problems.append(
                        f"stream {ref}: font {fname} ({font.basefont}) has no glyph for "
                        + " ".join(repr(c) for c in sorted(errs)) + f" in {MARK_OPEN}{inner}{MARK_CLOSE}")
                out.append("<" + raw.hex().upper() + ">")
            last = b
        out.append(body[last:])
        try:
            new = "".join(out).encode("latin1")
        except UnicodeEncodeError as e:
            problems.append(f"stream {ref}: non-Latin-1 character {body[e.start]!r} outside "
                            f"{MARK_OPEN}{MARK_CLOSE} marks")
            continue
        if new != orig.encode("latin1"):
            changed[ref] = new
    return changed, problems


def write_pdf(doc, src, dst, changed, workdir):
    update = {"qpdf": [
        {"jsonversion": 2, "pushedinheritedpageresources": False,
         "calledgetallpages": False, "maxobjectid": doc.header["maxobjectid"]},
        {"obj:" + ref: {"stream": {"dict": doc.objs["obj:" + ref]["stream"]["dict"],
                                   "data": base64.b64encode(data).decode()}}
         for ref, data in changed.items()}]}
    upd = os.path.join(workdir, "update.json")
    with open(upd, "w") as f:
        json.dump(update, f)
    tmp = os.path.join(workdir, "out.pdf")
    r = subprocess.run(["qpdf", src, f"--update-from-json={upd}",
                        "--compress-streams=y", "--object-streams=generate", tmp])
    if r.returncode not in (0, 3):
        raise KeepWorkspace("qpdf failed to write the edited PDF; the work files are in " + workdir)
    r = subprocess.run(["qpdf", "--check", tmp], capture_output=True, text=True)
    if r.returncode not in (0, 3):
        raise KeepWorkspace(f"qpdf --check rejected the output; the work files are in {workdir}:\n"
                            f"{r.stdout}{r.stderr}")
    shutil.move(tmp, dst)


def page_ranges(pages):
    pages, out = sorted(pages), []
    for n in pages:
        if out and out[-1][1] == n - 1:
            out[-1][1] = n
        else:
            out.append([n, n])
    return ",".join(str(a) if a == b else f"{a}-{b}" for a, b in out)


def font_report(doc, units, pages_of, fonts):
    """Print per-font mapping coverage and which pages were scanned. No page text."""
    stats, missing, total = {}, {}, 0
    for ref, res, label in units:
        _, data = doc.stream(ref)
        s = data.decode("latin1")
        for a, b, kind, fname in text_strings(s):
            total += 1
            font = fonts.get(res, fname)
            if font is None:
                missing.setdefault(fname, set()).update(pages_of[ref])
                continue
            st = stats.setdefault(id(font), {"font": font, "names": set(), "pages": set(),
                                             "strings": 0, "unmapped": set()})
            st["names"].add(fname)
            st["pages"] |= pages_of[ref]
            st["strings"] += 1
            st["unmapped"] |= {c for c in font.codes(string_bytes(kind, s[a:b])) if c not in font.map}
    for st in stats.values():
        f = st["font"]
        print(f"{' '.join(sorted(st['names']))} {f.basefont} {f.subtype} "
              f"ToUnicode={'yes' if f.has_tounicode else 'no'} code bytes={f.lengths} "
              f"mapped codes={len(f.map)} unmapped codes in use={len(st['unmapped'])} "
              f"strings={st['strings']} pages={page_ranges(st['pages'])}")
    for fname, pages in missing.items():
        print(f"{fname}: not found in resources, pages={page_ranges(pages)}")
    forms = [r for r, _, label in units if ", form " in label]
    shared = [r for r in forms if len(pages_of[r]) > 1]
    scanned = set().union(*pages_of.values()) if pages_of else set()
    print(f"Scanned {len(scanned)} of {len(doc.pages)} pages: {len(units) - len(forms)} content "
          f"streams, {len(forms)} form XObjects ({len(shared)} drawn on more than one page), "
          f"{total} text strings.")


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    p.add_argument("pdf")
    p.add_argument("-o", "--output")
    p.add_argument("-f", "--force", action="store_true", help="overwrite an existing output file")
    p.add_argument("--fonts", action="store_true", help="report fonts and mappings, then exit")
    args = p.parse_args()

    doc = Doc(args.pdf)
    units, pages_of = collect_units(doc)
    fonts = FontCache(doc)
    if args.fonts:
        font_report(doc, units, pages_of, fonts)
        return

    stem = args.pdf[:-4] if args.pdf.lower().endswith(".pdf") else args.pdf
    dst = args.output or stem + ".edited.pdf"
    if os.path.abspath(dst) == os.path.abspath(args.pdf):
        die("the output must be a different file from the input")
    if os.path.exists(dst) and not args.force:
        die(f"{dst} exists; pass -f to overwrite it")

    # The workspace holds the PDF's decoded text, so it lives in the current directory,
    # private to the user, rather than in a shared temp directory.
    workdir = tempfile.mkdtemp(prefix=".pdf-text-edit-", dir=os.getcwd())
    keep = False
    try:
        edit(doc, units, fonts, args.pdf, dst, workdir)
    except KeepWorkspace as e:
        keep = True
        die(str(e))
    finally:
        if not keep:
            shutil.rmtree(workdir, ignore_errors=True)


def editor_command():
    editor = shlex.split(os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vim")
    if os.path.basename(editor[0]) in ("vi", "vim", "nvim", "gvim", "mvim"):
        # No swap file, and no viminfo/shada, which would keep yanked text after exit.
        editor += ["-n", "-i", "NONE"]
    return editor


def edit(doc, units, fonts, src, dst, workdir):
    text, originals = export(doc, units, fonts)
    path = os.path.join(workdir, "text.pdftxt")
    with open(path, "w", encoding="utf-8", newline="") as f:
        f.write(text)
    editor = editor_command()

    while True:
        if subprocess.run(editor + [path]).returncode != 0:
            raise KeepWorkspace("the editor exited with an error; nothing was written. "
                                "Edits are in " + path)
        with open(path, encoding="utf-8", newline="") as f:
            changed, problems = reimport(f.read(), doc, units, fonts, originals)
        if not problems:
            break
        print("\n".join(problems), file=sys.stderr)
        if not sys.stdin.isatty() or input("Reopen the editor? [Y/n] ").strip().lower() == "n":
            raise KeepWorkspace("nothing was written. Edits are in " + path)

    if not changed:
        print("No text changed; nothing written.")
        return
    write_pdf(doc, src, dst, changed, workdir)
    print(f"Wrote {dst} ({len(changed)} stream(s) changed).")

if __name__ == "__main__":
    main()
