    except (OSError, subprocess.CalledProcessError) as exc:
        LOG.debug("qrencode failed: %s", exc)


def safe_filename(raw):
    """Reduce a client-supplied name to a single harmless path component."""
    name = os.path.basename((raw or "").replace("\\", "/").strip())
    name = re.sub(r"[\x00-\x1f\x7f]", "", name)
    if name in ("", ".", ".."):
        name = "upload-%s" % time.strftime("%Y%m%d-%H%M%S")
    return name[:200]


def create_unique(outdir, name):
    """Atomically reserve a free path near outdir/name. Returns (fd, path).

    iOS labels every camera capture image.jpg, so a phone emptying its camera
    roll is a stream of identical names; O_EXCL both renames them apart and
    keeps parallel uploads from landing on the same path."""
    stem, ext = os.path.splitext(name)
    candidate = name
    counter = 1
    while True:
        path = os.path.join(outdir, candidate)
        try:
            fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            return fd, path
        except FileExistsError:
            candidate = "%s-%d%s" % (stem, counter, ext)
            counter += 1
            if counter > 10000:
                raise


class MultipartError(ValueError):
    pass


# The stdlib stopped shipping a multipart parser when cgi was removed in 3.13,
# and the email package wants the whole body in memory. A phone uploading 4K
# video would make that a resident gigabyte, so the parser below reads the
# socket in fixed chunks and writes straight through to the file descriptor.


class BodyReader:
    """Buffered reader over a request body of known length."""

    def __init__(self, fp, length):
        self.fp = fp
        self.remaining = length
        self.buf = b""

    def _fill(self, want):
        while len(self.buf) < want and self.remaining > 0:
            chunk = self.fp.read(min(CHUNK, self.remaining))
            if not chunk:
                self.remaining = 0
                break
            self.remaining -= len(chunk)
            self.buf += chunk
        return len(self.buf)

    def read_exact(self, count):
        if self._fill(count) < count:
            raise MultipartError("body ended early")
        out, self.buf = self.buf[:count], self.buf[count:]
        return out

    def read_line(self):
        while b"\n" not in self.buf:
            before = len(self.buf)
            if before > MAX_HEADER_BYTES:
                raise MultipartError("multipart header line too long")
            if self._fill(before + CHUNK) == before:
                break
        idx = self.buf.find(b"\n")
        if idx < 0:
            out, self.buf = self.buf, b""
            return out
        out, self.buf = self.buf[: idx + 1], self.buf[idx + 1 :]
        return out

    def stream_until(self, sep, write):
        """Write body bytes to `write` until `sep`, which is consumed."""
        keep = len(sep) - 1
        while True:
            self._fill(len(sep) + CHUNK)
            idx = self.buf.find(sep)
            if idx >= 0:
                write(self.buf[:idx])
                self.buf = self.buf[idx + len(sep) :]
                return
            if self.remaining <= 0:
                raise MultipartError("unterminated multipart part")
            if len(self.buf) > keep:
                write(self.buf[:-keep])
                self.buf = self.buf[-keep:]


def boundary_from(content_type):
    match = re.search(r'boundary=(?:"([^"]+)"|([^;]+))', content_type or "", re.I)
    if not match:
        raise MultipartError("missing multipart boundary")
    return (match.group(1) or match.group(2)).strip().encode("latin-1")


def filename_from(disposition):
    match = re.search(r"filename\*\s*=\s*([^;]+)", disposition, re.I)
    if match:
        value = match.group(1).strip()
        _, _, encoded = value.rpartition("'")
        return urllib.parse.unquote(encoded)
    match = re.search(r'filename\s*=\s*"((?:[^"\\]|\\.)*)"', disposition, re.I)
    if match:
        return match.group(1).replace('\\"', '"')
    match = re.search(r"filename\s*=\s*([^;]+)", disposition, re.I)
    return match.group(1).strip() if match else ""


def receive_multipart(reader, boundary, outdir):
    """Stream every file part straight to disk. Returns the saved basenames."""
    delimiter = b"--" + boundary
    first = reader.read_line().rstrip(b"\r\n")
    if first != delimiter:
        raise MultipartError("body does not start with the multipart boundary")

    saved = []
    while True:
        headers = {}
        while True:
            line = reader.read_line()
            if line in (b"\r\n", b"\n", b""):
                break
            key, _, value = line.decode("utf-8", "replace").partition(":")
            headers[key.strip().lower()] = value.strip()

        disposition = headers.get("content-disposition", "")
        raw_name = filename_from(disposition)
        terminator = b"\r\n" + delimiter

        if raw_name:
            name = safe_filename(raw_name)
            fd, path = create_unique(outdir, name)
            written = 0

            def write(data, fd=fd):
                nonlocal written
                if data:
                    os.write(fd, data)
                    written += len(data)

            try:
                reader.stream_until(terminator, write)
            except Exception:
                os.close(fd)
                os.unlink(path)
                raise
            os.close(fd)
            os.chmod(path, 0o644)
            LOG.info("saved %s (%d bytes)", path, written)
            saved.append(os.path.basename(path))
        else:
            # A non-file field: drain it, we have no use for its value.
            reader.stream_until(terminator, lambda data: None)

        tail = reader.read_exact(2)
        if tail == b"--":
            return saved
        if tail != b"\r\n":
            raise MultipartError("malformed multipart delimiter")


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    # Naming the software points a reader at this source, and with it the
    # endpoint list and the default save directory. Stock error pages identify
    # http.server just as plainly, so both are replaced with the bare minimum.
    error_message_format = "%(code)d\n"
    error_content_type = "text/plain; charset=utf-8"

    def send_header(self, keyword, value):
        if keyword.lower() == "server":
            return
        super().send_header(keyword, value)

    # Set by serve()
    session = None
    offered = []
    prefix = ""
    head_only = False

    def log_message(self, fmt, *fmt_args):
        LOG.debug("%s - %s", self.address_string(), fmt % fmt_args)

    def route(self):
        """Strip the token prefix. Returns the remaining path, or None if unauthorized."""
        path = urllib.parse.urlparse(self.path).path
        if not self.prefix:
            return path
        if path == self.prefix:
            return "redirect"
        if path.startswith(self.prefix + "/"):
            return path[len(self.prefix) :]
        return None

    def send_bytes(self, payload, content_type, status=HTTPStatus.OK, extra=None):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        for key, value in (extra or {}).items():
            self.send_header(key, value)
        self.end_headers()
        if not self.head_only:
            self.wfile.write(payload)

    def send_json(self, obj, status=HTTPStatus.OK):
        self.send_bytes(json.dumps(obj).encode("utf-8"), "application/json", status)

    def fail(self, status, message):
        self.send_bytes(
            ("%s\n" % message).encode("utf-8"), "text/plain; charset=utf-8", status
        )

    def do_HEAD(self):
        self.do_GET(head_only=True)

    def do_GET(self, head_only=False):
        self.head_only = head_only
        path = self.route()
        if path is None:
            self.fail(HTTPStatus.NOT_FOUND, "not found")
            return
        if path == "redirect":
            self.send_response(HTTPStatus.MOVED_PERMANENTLY)
            self.send_header("Location", self.prefix + "/")
            self.send_header("Content-Length", "0")
            self.end_headers()
            return

        if path in ("/", "/index.html"):
            self.send_page()
        elif path.startswith("/dl/"):
            self.send_offered(path[len("/dl/") :])
        elif path == "/zip":
            self.send_zip()
        elif path == "/favicon.ico":
            self.send_bytes(b"", "image/x-icon", HTTPStatus.NO_CONTENT)
        else:
            self.fail(HTTPStatus.NOT_FOUND, "not found")

    def do_POST(self):
        self.head_only = False
        path = self.route()
        if path is None or path != "/upload":
            self.fail(HTTPStatus.NOT_FOUND, "not found")
            return

        try:
            length = int(self.headers.get("Content-Length", ""))
        except ValueError:
            self.fail(HTTPStatus.LENGTH_REQUIRED, "Content-Length required")
            return

        try:
            boundary = boundary_from(self.headers.get("Content-Type", ""))
            reader = BodyReader(self.rfile, length)
            saved = receive_multipart(reader, boundary, self.session.ensure())
        except MultipartError as exc:
            LOG.warning("bad upload from %s: %s", self.address_string(), exc)
            self.send_json({"error": str(exc)}, HTTPStatus.BAD_REQUEST)
            self.close_connection = True
            return
        except ConnectionError:
            # The upload died with the connection; there is nobody left to answer.
            LOG.info("upload from %s was interrupted", self.address_string())
            self.close_connection = True
            return
        except OSError as exc:
            LOG.error("could not save upload: %s", exc)
            self.send_json({"error": "could not save: %s" % exc.strerror},
                           HTTPStatus.INTERNAL_SERVER_ERROR)
            self.close_connection = True
            return

        if not saved:
            self.send_json({"error": "no file in request"}, HTTPStatus.BAD_REQUEST)
            return
        self.send_json({"saved": saved})

    def send_page(self):
        data = {
            "files": [
                {
                    "name": name,
                    "size": os.path.getsize(path) if os.path.exists(path) else 0,
                    "url": "dl/%d" % index,
                }
                for index, (name, path) in enumerate(self.offered)
            ],
        }
        page = PAGE.replace("__DATA__", json.dumps(data))
        self.send_bytes(page.encode("utf-8"), "text/html; charset=utf-8")

    def send_offered(self, raw_index):
        """Serve one of the files named on the command line.

        The URL carries an index into that list rather than a path, so no
        string from the network is ever resolved against the filesystem."""
        try:
            name, path = self.offered[int(raw_index)]
        except (ValueError, IndexError):
            self.fail(HTTPStatus.NOT_FOUND, "no such file")
            return
        try:
            size = os.path.getsize(path)
            handle = open(path, "rb")
        except OSError as exc:
            self.fail(HTTPStatus.NOT_FOUND, "cannot read file: %s" % exc.strerror)
            return

        basename = os.path.basename(name)
        guessed = mimetypes.guess_type(basename)[0] or "application/octet-stream"
        with handle:
            self.send_response(HTTPStatus.OK)
            self.send_header("Content-Type", guessed)
            self.send_header("Content-Length", str(size))
            # Plain filename for clients that only read the ASCII form,
            # filename* for everything that speaks RFC 5987.
            ascii_name = (
                basename.encode("ascii", "replace").decode("ascii").replace('"', "'")
            )
            self.send_header(
                "Content-Disposition",
                'attachment; filename="%s"; filename*=UTF-8\'\'%s'
                % (ascii_name, urllib.parse.quote(basename)),
            )
            self.end_headers()
            if not self.head_only:
                shutil.copyfileobj(handle, self.wfile, CHUNK)
        LOG.info("sent %s to %s", path, self.address_string())

    def send_zip(self):
        if not self.offered:
            self.fail(HTTPStatus.NOT_FOUND, "nothing to download")
            return
        # Spooled so a big set of files never has to fit in memory.
        with tempfile.SpooledTemporaryFile(max_size=32 * 1024 * 1024) as spool:
            # Stored, not deflated: the usual payload is already-compressed
            # media or documents, where the CPU buys nothing.
            with zipfile.ZipFile(spool, "w", zipfile.ZIP_STORED) as archive:
                for name, path in self.offered:
                    archive.write(path, arcname=name)
            size = spool.tell()
            spool.seek(0)
            self.send_response(HTTPStatus.OK)
            self.send_header("Content-Type", "application/zip")
            self.send_header("Content-Length", str(size))
            self.send_header(
                "Content-Disposition", 'attachment; filename="webdrop.zip"'
            )
            self.end_headers()
            if not self.head_only:
                shutil.copyfileobj(spool, self.wfile, CHUNK)
        LOG.info("sent zip of %d files to %s", len(self.offered), self.address_string())


class Server(ThreadingHTTPServer):
    # Threaded so a long upload doesn't wedge the page for a second device, and
    # daemonised so Ctrl-C ends the run without waiting on an idle keep-alive.
    daemon_threads = True

    def handle_error(self, request, client_address):
        """A phone that sleeps, backgrounds the tab, or cancels a download drops
        its connection mid-request. That is routine, so it gets a debug line
        instead of a traceback; anything else is a real bug and still gets one."""
        exc = sys.exc_info()[1]
        if isinstance(exc, (ConnectionError, TimeoutError)):
            LOG.debug("%s went away: %s", client_address[0], exc)
            return
        LOG.exception("error handling request from %s", client_address[0])


def serve(args, session, offered):
    Handler.session = session
    Handler.offered = offered
    Handler.prefix = "/" + args.token.strip("/") if args.token else ""

    try:
        httpd = Server((args.bind, args.port), Handler)
    except OSError as exc:
        if exc.errno == errno.EADDRINUSE:
            LOG.error("port %d is already in use, pick another with -p", args.port)
            sys.exit(1)
        raise

    url = "http://%s:%d%s/" % (lan_address(), args.port, Handler.prefix)
    print_qr(url)
    LOG.info("serving %s", url)
    LOG.info("uploads go to %s", session.path)
    if offered:
        LOG.info("offering %d file(s) for download", len(offered))
    if not args.token:
        LOG.warning("no token set: anyone on this network can upload and download")

    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        LOG.info("shutting down")
    finally:
        httpd.server_close()


def main():
    args = parse_args()
    mimetypes.init()
    session = SessionDir(pick_parent(args.outdir))
    offered = collect_offered(args.files)
    serve(args, session, offered)


if __name__ == "__main__":
    main()
