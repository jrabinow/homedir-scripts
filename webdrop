def parse_args():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "-d",
        "--debug",
        action="store_true",
        help="enable debug logging information",
    )
    parser.add_argument(
        "-p",
        "--port",
        type=int,
        default=DEFAULT_PORT,
        help="port to listen on (default: %(default)s)",
    )
    parser.add_argument(
        "-b",
        "--bind",
        help="address to bind (default: the first LAN interface's address; "
        "0.0.0.0 listens on every interface, VPN tunnels included)",
    )
    parser.add_argument(
        "-o",
        "--outdir",
        help="parent for this run's upload directory "
        "(default: ~/Downloads, else the current directory)",
    )
    parser.add_argument(
        "-t",
        "--token",
        nargs="?",
        const=secrets.token_urlsafe(6),
        default="",
        metavar="TOKEN",
        help="require a secret path segment in the URL; generated when given no value",
    )
    parser.add_argument(
        "--lift-mac-firewall",
        action="store_true",
        help="when the macOS firewall blocks all incoming connections, open its "
        "settings and wait for you to turn that off; at exit, open them again "
        "to turn it back on",
    )
    parser.add_argument(
        "files",
        nargs="*",
        help="offer these files for download; directories are expanded recursively",
    )
    args = parser.parse_args()
    if args.debug:
        LOG.setLevel(logging.DEBUG)
    return args


def pick_parent(override):
    """The directory this run's uploads will be collected under."""
    if override:
        parent = os.path.abspath(os.path.expanduser(override))
        if not os.path.isdir(parent):
            LOG.error("no such directory: %s", parent)
            sys.exit(1)
    else:
        downloads = os.path.expanduser("~/Downloads")
        parent = downloads if os.path.isdir(downloads) else os.getcwd()
    if not os.access(parent, os.W_OK):
        LOG.error("directory is not writable: %s", parent)
        sys.exit(1)
    return parent


class SessionDir:
    """Uploads land in one directory per run, created on the first arrival.

    Naming a file after a collision ("report-1.pdf") tells the uploader that
    "report.pdf" was already there, which against a long-lived directory like
    ~/Downloads answers "does this file exist?" for anyone on the network. A
    per-run directory means collisions can only be with this run's own uploads,
    which whoever is holding the phone already knows about."""

    def __init__(self, parent):
        self.parent = parent
        self.path = os.path.join(
            parent, "webdrop-%s-%s" % (time.strftime("%Y-%m-%d"), secrets.token_hex(2))
        )
        self._lock = threading.Lock()
        self._made = False

    def ensure(self):
        with self._lock:
            if not self._made:
                os.makedirs(self.path, exist_ok=True)
                LOG.info("created %s", self.path)
                self._made = True
        return self.path


def collect_offered(paths):
    """Expand the command line into a flat list of (display name, absolute path)."""
    offered = []
    for path in paths:
        full = os.path.abspath(os.path.expanduser(path))
        if os.path.isdir(full):
            root_name = os.path.basename(full.rstrip(os.sep)) or "files"
            for dirpath, _, filenames in os.walk(full):
                for filename in sorted(filenames):
                    child = os.path.join(dirpath, filename)
                    rel = os.path.relpath(child, full)
                    offered.append((os.path.join(root_name, rel), child))
        elif os.path.isfile(full):
            offered.append((os.path.basename(full), full))
        else:
            LOG.error("not a file or directory: %s", path)
            sys.exit(1)
    return offered


def lan_addresses():
    """(interface, IPv4 address) for each LAN interface that has one."""
    found = []
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        for _, name in socket.if_nameindex():
            if not name.startswith(LAN_PREFIXES):
                continue
            try:
                reply = fcntl.ioctl(
                    sock.fileno(), SIOCGIFADDR, struct.pack("256s", name.encode())
                )
            except OSError as exc:
                if exc.errno == errno.EADDRNOTAVAIL:  # up, but no IPv4 address
                    continue
                raise
            # struct ifreq: a 16-byte name, then a sockaddr_in whose address
            # sits after 2 bytes of family and 2 of port.
            found.append((name, socket.inet_ntoa(reply[20:24])))
    return found


def pick_address(bind):
    """Returns (address to bind, address to put in the URL)."""
    if bind and bind != "0.0.0.0":
        return bind, bind
    found = lan_addresses()
    if not found:
        LOG.error("no LAN interface (%s*) has an IPv4 address; pass -b ADDRESS",
                  "*, ".join(LAN_PREFIXES))
        sys.exit(1)
    name, address = found[0]
    LOG.info("using %s on %s", address, name)
    for other_name, other in found[1:]:
        LOG.info("%s also has %s; pass -b %s to serve there", other_name, other, other)
    return bind or address, address


BLOCK_ALL_SETTING = (
    '"Block all incoming connections" in System Settings > Network > Firewall > Options'
)


def firewall_blocks_all():
    """Whether the macOS firewall cuts every incoming connection.

    In that mode the kernel completes the TCP handshake and then drops the
    socket, so the server sees ENOTCONN and the phone an empty reply, with
    nothing pointing at the firewall."""
    try:
        state = subprocess.run(
            ["/usr/libexec/ApplicationFirewall/socketfilterfw", "--getblockall"],
            capture_output=True, text=True, check=True,
        ).stdout
    except (OSError, subprocess.CalledProcessError) as exc:
        LOG.debug("could not read the firewall state: %s", exc)
        return False
    return "blocking all" in state


def open_firewall_settings():
    subprocess.run(
        ["open", "x-apple.systempreferences:com.apple.Network-Settings.extension?Firewall"],
        check=False,
    )


def check_firewall(bind, lift):
    """Make sure the LAN can reach webdrop. Returns whether the user lifted
    the firewall for this run, so they can be asked to restore it at exit."""
    if sys.platform != "darwin" or bind.startswith("127.") or not firewall_blocks_all():
        return False
    if not lift:
        LOG.error("the macOS firewall blocks all incoming connections, so no other "
                  "device can reach webdrop. Turn off %s, or pass --lift-mac-firewall.",
                  BLOCK_ALL_SETTING)
        sys.exit(1)
    open_firewall_settings()
    LOG.warning("turn off %s for this run; webdrop starts once it is off", BLOCK_ALL_SETTING)
    try:
        while firewall_blocks_all():
            time.sleep(1)
    except KeyboardInterrupt:
        LOG.info("shutting down")
        sys.exit(1)
    LOG.info("firewall lifted")
    return True


def print_qr(url):
    if not shutil.which("qrencode"):
        return
    try:
        subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "2", url], check=True)
    except (OSError, subprocess.CalledProcessError) as exc:
        LOG.debug("qrencode failed: %s", exc)


def safe_filename(raw):
    """Reduce a client-supplied name to a single harmless path component."""
    name = os.path.basename((raw or "").replace("\\", "/").strip())
    name = re.sub(r"[\x00-\x1f\x7f]", "", name)
    if name in ("", ".", ".."):
        name = "upload-%s" % time.strftime("%Y%m%d-%H%M%S")
    return name[:200]


def create_unique(outdir, name):
    """Atomically reserve a free path near outdir/name. Returns (fd, path).

    iOS labels every camera capture image.jpg, so a phone emptying its camera
    roll is a stream of identical names; O_EXCL both renames them apart and
    keeps parallel uploads from landing on the same path."""
    stem, ext = os.path.splitext(name)
    candidate = name
    counter = 1
    while True:
        path = os.path.join(outdir, candidate)
        try:
            fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            return fd, path
        except FileExistsError:
            candidate = "%s-%d%s" % (stem, counter, ext)
            counter += 1
            if counter > 10000:
                raise


class TextBoard:
    """Every text sent this run, from the page or the terminal, in order."""

    def __init__(self):
        self._lock = threading.Lock()
        self._texts = []

    def add(self, text, sender):
        with self._lock:
            self._texts.append({"text": text, "from": sender})

    def all(self):
        with self._lock:
            return list(self._texts)


def relay_stdin(board):
    """Post what arrives on stdin to the page: each line typed into a
    terminal as its own text, or everything piped in as one."""
    if sys.stdin.isatty():
        for line in sys.stdin:
            text = line.rstrip("\r\n")
            if text.strip():
                board.add(text, "this computer")
    else:
        # Trailing newlines dropped, as the shell's $(...) does: `echo` adds one.
        text = sys.stdin.read().rstrip("\r\n")
        if text.strip():
            board.add(text, "this computer")
            LOG.info("sent %d characters from stdin to the page", len(text))


class MultipartError(ValueError):
    pass


# The stdlib stopped shipping a multipart parser when cgi was removed in 3.13,
# and the email package wants the whole body in memory. A phone uploading 4K
# video would make that a resident gigabyte, so the parser below reads the
# socket in fixed chunks and writes straight through to the file descriptor.


class BodyReader:
    """Buffered reader over a request body of known length."""

    def __init__(self, fp, length):
        self.fp = fp
        self.remaining = length
        self.buf = b""

    def _fill(self, want):
        while len(self.buf) < want and self.remaining > 0:
            chunk = self.fp.read(min(CHUNK, self.remaining))
            if not chunk:
                self.remaining = 0
                break
            self.remaining -= len(chunk)
            self.buf += chunk
        return len(self.buf)

    def read_exact(self, count):
        if self._fill(count) < count:
            raise MultipartError("body ended early")
        out, self.buf = self.buf[:count], self.buf[count:]
        return out

    def read_line(self):
        while b"\n" not in self.buf:
            before = len(self.buf)
            if before > MAX_HEADER_BYTES:
                raise MultipartError("multipart header line too long")
            if self._fill(before + CHUNK) == before:
                break
        idx = self.buf.find(b"\n")
        if idx < 0:
            out, self.buf = self.buf, b""
            return out
        out, self.buf = self.buf[: idx + 1], self.buf[idx + 1 :]
        return out

    def stream_until(self, sep, write):
        """Write body bytes to `write` until `sep`, which is consumed."""
        keep = len(sep) - 1
        while True:
            self._fill(len(sep) + CHUNK)
            idx = self.buf.find(sep)
            if idx >= 0:
                write(self.buf[:idx])
                self.buf = self.buf[idx + len(sep) :]
                return
            if self.remaining <= 0:
                raise MultipartError("unterminated multipart part")
            if len(self.buf) > keep:
                write(self.buf[:-keep])
                self.buf = self.buf[-keep:]


def boundary_from(content_type):
    match = re.search(r'boundary=(?:"([^"]+)"|([^;]+))', content_type or "", re.I)
    if not match:
        raise MultipartError("missing multipart boundary")
    return (match.group(1) or match.group(2)).strip().encode("latin-1")


def filename_from(disposition):
    match = re.search(r"filename\*\s*=\s*([^;]+)", disposition, re.I)
    if match:
        value = match.group(1).strip()
        _, _, encoded = value.rpartition("'")
        return urllib.parse.unquote(encoded)
    match = re.search(r'filename\s*=\s*"((?:[^"\\]|\\.)*)"', disposition, re.I)
    if match:
        return match.group(1).replace('\\"', '"')
    match = re.search(r"filename\s*=\s*([^;]+)", disposition, re.I)
    return match.group(1).strip() if match else ""


def receive_multipart(reader, boundary, outdir):
    """Stream every file part straight to disk. Returns the saved basenames."""
    delimiter = b"--" + boundary
    first = reader.read_line().rstrip(b"\r\n")
    if first != delimiter:
        raise MultipartError("body does not start with the multipart boundary")

    saved = []
    while True:
        headers = {}
        while True:
            line = reader.read_line()
            if line in (b"\r\n", b"\n", b""):
                break
            key, _, value = line.decode("utf-8", "replace").partition(":")
            headers[key.strip().lower()] = value.strip()

        disposition = headers.get("content-disposition", "")
        raw_name = filename_from(disposition)
        terminator = b"\r\n" + delimiter

        if raw_name:
            name = safe_filename(raw_name)
            fd, path = create_unique(outdir, name)
            written = 0

            def write(data, fd=fd):
                nonlocal written
                if data:
                    os.write(fd, data)
                    written += len(data)

            try:
                reader.stream_until(terminator, write)
            except Exception:
                os.close(fd)
                os.unlink(path)
                raise
            os.close(fd)
            os.chmod(path, 0o644)
            LOG.info("saved %s (%d bytes)", path, written)
            saved.append(os.path.basename(path))
        else:
            # A non-file field: drain it, we have no use for its value.
            reader.stream_until(terminator, lambda data: None)

        tail = reader.read_exact(2)
        if tail == b"--":
            return saved
        if tail != b"\r\n":
            raise MultipartError("malformed multipart delimiter")


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    # Naming the software points a reader at this source, and with it the
    # endpoint list and the default save directory. Stock error pages identify
    # http.server just as plainly, so both are replaced with the bare minimum.
    error_message_format = "%(code)d\n"
    error_content_type = "text/plain; charset=utf-8"

    def send_header(self, keyword, value):
        if keyword.lower() == "server":
            return
        super().send_header(keyword, value)

    # Set by serve()
    session = None
    board = None
    offered = []
    prefix = ""
    head_only = False

    def log_message(self, fmt, *fmt_args):
        LOG.debug("%s - %s", self.address_string(), fmt % fmt_args)

    def route(self):
        """Strip the token prefix. Returns the remaining path, or None if unauthorized."""
        path = urllib.parse.urlparse(self.path).path
        if not self.prefix:
            return path
        if path == self.prefix:
            return "redirect"
        if path.startswith(self.prefix + "/"):
            return path[len(self.prefix) :]
        return None

    def send_bytes(self, payload, content_type, status=HTTPStatus.OK, extra=None):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        for key, value in (extra or {}).items():
            self.send_header(key, value)
        self.end_headers()
        if not self.head_only:
            self.wfile.write(payload)

    def send_json(self, obj, status=HTTPStatus.OK):
        self.send_bytes(json.dumps(obj).encode("utf-8"), "application/json", status)

    def fail(self, status, message):
        self.send_bytes(
            ("%s\n" % message).encode("utf-8"), "text/plain; charset=utf-8", status
        )

    def do_HEAD(self):
        self.do_GET(head_only=True)

    def do_GET(self, head_only=False):
        self.head_only = head_only
        path = self.route()
        if path is None:
            self.fail(HTTPStatus.NOT_FOUND, "not found")
            return
        if path == "redirect":
            self.send_response(HTTPStatus.MOVED_PERMANENTLY)
            self.send_header("Location", self.prefix + "/")
            self.send_header("Content-Length", "0")
            self.end_headers()
            return

        if path in ("/", "/index.html"):
            self.send_page()
        elif path.startswith("/dl/"):
            self.send_offered(path[len("/dl/") :])
        elif path == "/zip":
            self.send_zip()
        elif path == "/state":
            self.send_state()
        elif path == "/favicon.ico":
            self.send_bytes(b"", "image/x-icon", HTTPStatus.NO_CONTENT)
        else:
            self.fail(HTTPStatus.NOT_FOUND, "not found")

    def do_POST(self):
        self.head_only = False
        path = self.route()
        if path not in ("/upload", "/text"):
            self.fail(HTTPStatus.NOT_FOUND, "not found")
            return

        try:
            length = int(self.headers.get("Content-Length", ""))
        except ValueError:
            self.fail(HTTPStatus.LENGTH_REQUIRED, "Content-Length required")
            return

        if path == "/text":
            self.receive_text(length)
        else:
            self.receive_upload(length)

    def receive_text(self, length):
        if length > MAX_TEXT_BYTES:
            self.fail(HTTPStatus.REQUEST_ENTITY_TOO_LARGE,
                      "text over %d KB; send it as a file" % (MAX_TEXT_BYTES // 1024))
            self.close_connection = True
            return
        text = self.rfile.read(length).decode("utf-8", "replace")
        if not text.strip():
            self.fail(HTTPStatus.BAD_REQUEST, "empty text")
            return
        sender = self.address_string()
        self.board.add(text, sender)
        LOG.info("text from %s:\n%s", sender, text)
        self.send_bytes(b"", "text/plain", HTTPStatus.NO_CONTENT)

    def receive_upload(self, length):
        try:
            boundary = boundary_from(self.headers.get("Content-Type", ""))
            reader = BodyReader(self.rfile, length)
            saved = receive_multipart(reader, boundary, self.session.ensure())
        except MultipartError as exc:
            LOG.warning("bad upload from %s: %s", self.address_string(), exc)
            self.send_json({"error": str(exc)}, HTTPStatus.BAD_REQUEST)
            self.close_connection = True
            return
        except ConnectionError:
            # The upload died with the connection; there is nobody left to answer.
            LOG.info("upload from %s was interrupted", self.address_string())
            self.close_connection = True
            return
        except OSError as exc:
            LOG.error("could not save upload: %s", exc)
            self.send_json({"error": "could not save: %s" % exc.strerror},
                           HTTPStatus.INTERNAL_SERVER_ERROR)
            self.close_connection = True
            return

        if not saved:
            self.send_json({"error": "no file in request"}, HTTPStatus.BAD_REQUEST)
            return
        self.send_json({"saved": saved})

    def send_page(self):
        self.send_bytes(PAGE.encode("utf-8"), "text/html; charset=utf-8")

    def send_state(self):
        self.send_json({
            "files": [
                {
                    "name": name,
                    "size": os.path.getsize(path) if os.path.exists(path) else 0,
                    "url": "dl/%d" % index,
                }
                for index, (name, path) in enumerate(self.offered)
            ],
            "texts": self.board.all(),
        })

    def send_offered(self, raw_index):
        """Serve one of the files named on the command line.

        The URL carries an index into that list rather than a path, so no
        string from the network is ever resolved against the filesystem."""
        try:
            name, path = self.offered[int(raw_index)]
        except (ValueError, IndexError):
            self.fail(HTTPStatus.NOT_FOUND, "no such file")
            return
        try:
            size = os.path.getsize(path)
            handle = open(path, "rb")
        except OSError as exc:
            self.fail(HTTPStatus.NOT_FOUND, "cannot read file: %s" % exc.strerror)
            return

        basename = os.path.basename(name)
        guessed = mimetypes.guess_type(basename)[0] or "application/octet-stream"
        with handle:
            self.send_response(HTTPStatus.OK)
            self.send_header("Content-Type", guessed)
            self.send_header("Content-Length", str(size))
            # Plain filename for clients that only read the ASCII form,
            # filename* for everything that speaks RFC 5987.
            ascii_name = (
                basename.encode("ascii", "replace").decode("ascii").replace('"', "'")
            )
            self.send_header(
                "Content-Disposition",
                'attachment; filename="%s"; filename*=UTF-8\'\'%s'
                % (ascii_name, urllib.parse.quote(basename)),
            )
            self.end_headers()
            if not self.head_only:
                shutil.copyfileobj(handle, self.wfile, CHUNK)
        LOG.info("sent %s to %s", path, self.address_string())

    def send_zip(self):
        if not self.offered:
            self.fail(HTTPStatus.NOT_FOUND, "nothing to download")
            return
        # Spooled so a big set of files never has to fit in memory.
        with tempfile.SpooledTemporaryFile(max_size=32 * 1024 * 1024) as spool:
            # Stored, not deflated: the usual payload is already-compressed
            # media or documents, where the CPU buys nothing.
            with zipfile.ZipFile(spool, "w", zipfile.ZIP_STORED) as archive:
                for name, path in self.offered:
                    archive.write(path, arcname=name)
            size = spool.tell()
            spool.seek(0)
            self.send_response(HTTPStatus.OK)
            self.send_header("Content-Type", "application/zip")
            self.send_header("Content-Length", str(size))
            self.send_header(
                "Content-Disposition", 'attachment; filename="webdrop.zip"'
            )
            self.end_headers()
            if not self.head_only:
                shutil.copyfileobj(spool, self.wfile, CHUNK)
        LOG.info("sent zip of %d files to %s", len(self.offered), self.address_string())


class Server(ThreadingHTTPServer):
    # Threaded so a long upload doesn't wedge the page for a second device, and
    # daemonised so Ctrl-C ends the run without waiting on an idle keep-alive.
    daemon_threads = True

    def handle_error(self, request, client_address):
        """A phone that sleeps, backgrounds the tab, or cancels a download drops
        its connection mid-request. That is routine, so it gets a debug line
        instead of a traceback; anything else is a real bug and still gets one."""
        exc = sys.exc_info()[1]
        if isinstance(exc, (ConnectionError, TimeoutError)):
            LOG.debug("%s went away: %s", client_address[0], exc)
            return
        if isinstance(exc, OSError) and exc.errno == errno.ENOTCONN:
            # Not routine: the device never got an answer.
            LOG.warning("connection from %s was cut before its request arrived; "
                        "the macOS firewall does this to connections it blocks",
                        client_address[0])
            return
        LOG.exception("error handling request from %s", client_address[0])


def serve(args, session, offered):
    Handler.session = session
    Handler.board = TextBoard()
    Handler.offered = offered
    Handler.prefix = "/" + args.token.strip("/") if args.token else ""

    bind, host = pick_address(args.bind)
    # Bound before the firewall is lifted, so a busy port can't end the run
    # with the firewall left down and no reminder.
    try:
        httpd = Server((bind, args.port), Handler)
    except OSError as exc:
        if exc.errno == errno.EADDRINUSE:
            LOG.error("port %d is already in use, pick another with -p", args.port)
            sys.exit(1)
        raise
    lifted = check_firewall(bind, args.lift_mac_firewall)

    url = "http://%s:%d%s/" % (host, args.port, Handler.prefix)
    print_qr(url)
    LOG.info("serving %s", url)
    LOG.info("uploads go to %s", session.path)
    if offered:
        LOG.info("offering %d file(s) for download", len(offered))
    if not args.token:
        LOG.warning("no token set: anyone on this network can upload and download")
    threading.Thread(target=relay_stdin, args=(Handler.board,), daemon=True).start()
    if sys.stdin.isatty():
        LOG.info("type a line and press Enter to send it to the page")

    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        LOG.info("shutting down")
    finally:
        httpd.server_close()
        if lifted:
            open_firewall_settings()
            LOG.warning("turn %s back on", BLOCK_ALL_SETTING)


def main():
    args = parse_args()
    mimetypes.init()
    session = SessionDir(pick_parent(args.outdir))
    offered = collect_offered(args.files)
    serve(args, session, offered)


if __name__ == "__main__":
    main()
