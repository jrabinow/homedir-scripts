// One request per file, sent one at a time: each row gets its own progress and
// its own failure, so a stalled video neither hides the rest nor takes them
// down with it, and a retry costs only that file.
var queue = [], busy = false;

function addFiles(files) {
  for (var i = 0; i < files.length; i++) {
