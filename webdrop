    document.getElementById("queue").appendChild(li);
    queue.push({ file: f, fill: fill, state: state, sub: sub });
  }
  pump();
}

function pump() {
  if (busy || !queue.length) return;
  busy = true;
  var job = queue.shift();
  var fd = new FormData();
  fd.append("file", job.file, job.file.name || "upload");
  var xhr = new XMLHttpRequest();
  xhr.open("POST", "upload");
  xhr.upload.onprogress = function (e) {
    if (!e.lengthComputable) return;
    job.fill.style.width = (100 * e.loaded / e.total) + "%";
    job.state.textContent = Math.round(100 * e.loaded / e.total) + "%";
  };
  xhr.onload = function () {
    busy = false;
    var saved = null;
    try { saved = JSON.parse(xhr.responseText); } catch (err) { /* keep raw status */ }
    if (xhr.status === 200 && saved && saved.saved && saved.saved.length) {
      job.fill.style.width = "100%";
      job.state.className = "state ok";
      job.state.textContent = "saved";
      job.sub.textContent = human(job.file.size) + " \\u2192 " + saved.saved[0];
    } else {
      job.state.className = "state err";
      job.state.textContent = (saved && saved.error) || ("failed " + xhr.status);
    }
    pump();
  };
  xhr.onerror = function () {
    busy = false;
    job.state.className = "state err";
    job.state.textContent = "network error";
    pump();
  };
  xhr.send(fd);
}

