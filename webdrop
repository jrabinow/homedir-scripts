def parse_args():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "-d",
        "--debug",
        action="store_true",
        help="enable debug logging information",
    )
    parser.add_argument(
        "-p",
        "--port",
        type=int,
        default=DEFAULT_PORT,
        help="port to listen on (default: %(default)s)",
    )
    parser.add_argument(
        "-b",
        "--bind",
        default="0.0.0.0",
        help="address to bind (default: %(default)s, i.e. reachable from the LAN)",
    )
    parser.add_argument(
        "-o",
        "--outdir",
        help="parent for this run's upload directory "
        "(default: ~/Downloads, else the current directory)",
    )
    parser.add_argument(
        "-t",
        "--token",
        nargs="?",
        const=secrets.token_urlsafe(6),
        default="",
        metavar="TOKEN",
        help="require a secret path segment in the URL; generated when given no value",
    )
    parser.add_argument(
        "files",
        nargs="*",
        help="offer these files for download; directories are expanded recursively",
    )
    args = parser.parse_args()
    if args.debug:
        LOG.setLevel(logging.DEBUG)
    return args


def pick_parent(override):
    """The directory this run's uploads will be collected under."""
    if override:
        parent = os.path.abspath(os.path.expanduser(override))
        if not os.path.isdir(parent):
            LOG.error("no such directory: %s", parent)
            sys.exit(1)
    else:
        downloads = os.path.expanduser("~/Downloads")
        parent = downloads if os.path.isdir(downloads) else os.getcwd()
    if not os.access(parent, os.W_OK):
        LOG.error("directory is not writable: %s", parent)
        sys.exit(1)
    return parent


class SessionDir:
    """Uploads land in one directory per run, created on the first arrival.

    Naming a file after a collision ("report-1.pdf") tells the uploader that
    "report.pdf" was already there, which against a long-lived directory like
    ~/Downloads answers "does this file exist?" for anyone on the network. A
    per-run directory means collisions can only be with this run's own uploads,
    which whoever is holding the phone already knows about."""

    def __init__(self, parent):
        self.parent = parent
        self.path = os.path.join(
            parent, "webdrop-%s-%s" % (time.strftime("%Y-%m-%d"), secrets.token_hex(2))
        )
        self._lock = threading.Lock()
        self._made = False

    def ensure(self):
        with self._lock:
            if not self._made:
                os.makedirs(self.path, exist_ok=True)
                LOG.info("created %s", self.path)
                self._made = True
        return self.path


def collect_offered(paths):
    """Expand the command line into a flat list of (display name, absolute path)."""
    offered = []
    for path in paths:
        full = os.path.abspath(os.path.expanduser(path))
        if os.path.isdir(full):
            root_name = os.path.basename(full.rstrip(os.sep)) or "files"
            for dirpath, _, filenames in os.walk(full):
                for filename in sorted(filenames):
                    child = os.path.join(dirpath, filename)
                    rel = os.path.relpath(child, full)
                    offered.append((os.path.join(root_name, rel), child))
        elif os.path.isfile(full):
            offered.append((os.path.basename(full), full))
        else:
            LOG.error("not a file or directory: %s", path)
            sys.exit(1)
    return offered


def lan_address():
    """Best-effort local address the phone can actually reach."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        # No packet leaves the machine; this only asks the routing table.
        sock.connect(("8.8.8.8", 53))
        return sock.getsockname()[0]
    except OSError:
        return socket.gethostbyname(socket.gethostname())
    finally:
        sock.close()


def print_qr(url):
